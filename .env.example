# Copy this file to ".env" and paste your key in. TrustLens reads it from the
# environment only - never from the UI - and it is never logged or written out.
# ".env" is gitignored, so your key cannot reach GitHub.

# Get a key at https://aistudio.google.com/apikey
# Enables: detection of fully AI-generated images, language-model scam
# classification, SelfCheck consistency testing, and model-written
# explanations. Without it everything still runs on rules and forensics.
GEMINI_API_KEY=

# --- optional ---------------------------------------------------------------
# Default is the LITE alias. Two reasons: an alias does not go stale when
# Google retires a version (a pinned gemini-2.0-flash started 404-ing), and the
# lite model has far more free-tier headroom than the premium one, which a
# couple of analyses can exhaust.
# TRUSTLENS_VLM_MODEL=gemini-flash-lite-latest
# TRUSTLENS_TEXT_MODEL=gemini-flash-lite-latest

# Force the offline path even with a key set. Useful for demoing without
# network, and used by the test suite so tests stay fast and free.
# TRUSTLENS_NO_MODEL=1

# Verbose per-lane logging.
# TRUSTLENS_DEBUG=1
