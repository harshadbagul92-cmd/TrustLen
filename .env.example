# Hugging Face API Credentials
HF_TOKEN=your_huggingface_token_here
HF_IMAGE_MODEL=umm-maybe/AI-image-detector
HF_PROVIDER=hf-inference

# Detector Mode: mock | api | local
IMAGE_DETECTOR_MODE=mock

# Confidence Thresholds
CONFIDENCE_THRESHOLD_UNCERTAIN=0.60
CONFIDENCE_THRESHOLD_MODERATE=0.80

# Log Level
LOG_LEVEL=INFO
